+import numpy as np
 import pandas as pd
+
+
+_UNITS_PER_SECOND = {
+    "s": 1,
+    "ms": 10**3,
+    "us": 10**6,
+    "ns": 10**9,
+    "ps": 10**12,
+    "fs": 10**15,
+    "as": 10**18,
+}
+
+
+def _datetime_unit(dtype):
+    unit = getattr(dtype, "unit", None)
+    if unit in _UNITS_PER_SECOND:
+        return unit
+    try:
+        unit = np.datetime_data(dtype)[0]
+    except Exception:
+        unit = None
+    if unit in _UNITS_PER_SECOND:
+        return unit
+    # Fallback: parse representations such as 'datetime64[ns, UTC]'.
+    text = str(dtype)
+    for candidate in ("ns", "us", "ms", "ps", "fs", "as", "s"):
+        if f"[{candidate}" in text or f"[{candidate}," in text:
+            return candidate
+    raise ValueError(f"Unsupported datetime dtype: {dtype!r}")
 
 
 def to_epoch_seconds(timestamps):
